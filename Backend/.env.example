LLM_PROVIDERS=NVIDIA,OLLAMA

LLM_DEFAULT_PROVIDER=NVIDIA
LLM_DEFAULT_MODEL=z-ai/glm-5.3-flash

NVIDIA_LABEL=NVIDIA (cloud)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODELS=z-ai/glm-5.3-flash,openai/gpt-oss-20b
NVIDIA_FALLBACK_MODEL=openai/gpt-oss-20b
NVIDIA_CONCURRENCY=3

OLLAMA_LABEL=Ollama (local)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODELS=
OLLAMA_FALLBACK_MODEL=
# Timeout and concurrency suit a GPU server. On a CPU-only machine one resume can take
# 10+ minutes and parallel requests just split the cores, so use instead:
# OLLAMA_TIMEOUT=1200
# OLLAMA_CONCURRENCY=1
OLLAMA_TIMEOUT=300
OLLAMA_CONCURRENCY=2
# Must match the OLLAMA_CONTEXT_LENGTH the Ollama server is started with (see README);
# used only to log a warning when a prompt fills the context window and gets cut off
OLLAMA_CONTEXT_LENGTH=16384
# Forces valid JSON replies, so small models cannot return a broken answer
OLLAMA_JSON_MODE=true
# none turns off "thinking" (Qwen3 otherwise spends its whole answer thinking); other models ignore it
OLLAMA_REASONING_EFFORT=none

LLM_REASONING_EFFORT=low
LLM_TIMEOUT=90
LLM_CONCURRENCY=3

MAX_RESUMES=20
MAX_FILE_MB=10

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30
